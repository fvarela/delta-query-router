# Copy to .env (git-ignored) and fill in. Values identify the company's Azure
# tenant and must never be committed.

# Subscription that holds the resource group.
AZURE_SUBSCRIPTION_ID=
# Entra tenant of that subscription.
AZURE_TENANT_ID=
# Resource id of the user-assigned identity of the dev workspace's Access Connector
# (the identity of the existing Unity Catalog storage credentials).
UC_IDENTITY_RESOURCE_ID=
# Resource id of that Access Connector itself; the dev tool's storage credential uses it.
UC_ACCESS_CONNECTOR_ID=
# Name of the storage account the Bicep template created; print it with the read-only
# `az storage account list` command in AGENTS.md.
DQR_STORAGE_ACCOUNT=
# Optional. Catalog the dev tool uses; empty means the default, dqr. Set it to an existing
# catalog only if creating dqr is refused.
DQR_CATALOG=
# Databricks CLI profile the dev tool logs in with (read by the Databricks SDK).
DATABRICKS_CONFIG_PROFILE=
# Id of an existing SQL warehouse; the dev tool runs the CREATE TABLE statements on it.
DATABRICKS_WAREHOUSE_ID=
