# Copy to .env (git-ignored) and fill in. Values identify the company's Azure
# tenant and must never be committed.

# Subscription that holds the resource group.
AZURE_SUBSCRIPTION_ID=
# Entra tenant of that subscription.
AZURE_TENANT_ID=
# Resource id of the user-assigned identity of the dev workspace's Access Connector
# (the identity of the existing Unity Catalog storage credentials).
UC_IDENTITY_RESOURCE_ID=
